@using WordGame.Models.ViewModels
@model WordGame.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<h2 class="mb-4 text-center">🔒 @Localizer["PageHeader"]</h2>

<form asp-action="ChangePassword" method="post" class="w-50 mx-auto">
    <div class="form-group mb-3">
        <label asp-for="CurrentPassword" class="form-label">@Localizer["CurrentPasswordLabel"]</label>
        <input asp-for="CurrentPassword" class="form-control" type="password" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NewPassword" class="form-label">@Localizer["NewPasswordLabel"]</label>
        <input asp-for="NewPassword" class="form-control" type="password" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="form-group mb-4">
        <label asp-for="ConfirmPassword" class="form-label">@Localizer["ConfirmPasswordLabel"]</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">🔁 @Localizer["SubmitButton"]</button>
</form>