@{
    ViewData["Title"] = "WordGame";
    var userName = Context.Session.GetString("UserName");
}

<style>
    .hero {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        color: white;
        padding: 80px 20px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .hero h1 {
        font-size: 3rem;
        font-weight: 700;
    }

    .hero p {
        font-size: 1.2rem;
        margin-top: 15px;
        opacity: 0.9;
    }

    .action-btn {
        padding: 15px 30px;
        font-size: 1.1rem;
        border-radius: 30px;
    }

    .highlight-card {
        transition: 0.3s ease;
    }

    .highlight-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }
</style>

<div class="container mt-4">

    <!-- HERO SECTION -->
    <div class="hero text-center mb-5">
        <h1>🧠 @Localizer["WelcomeTitle"]</h1>
        @if (userName != null)
        {
            <p>@string.Format(Localizer["WelcomeGreeting"].Value, userName)</p>
            <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
                <a class="btn btn-light text-primary action-btn" asp-controller="Quiz" asp-action="Select">
                    <i class="fa-solid fa-spell-check me-2"></i> @Localizer["StartQuiz"]
                </a>
                <a class="btn btn-outline-light action-btn" asp-controller="Word" asp-action="Add">
                    <i class="fa-solid fa-plus me-2"></i> @Localizer["AddNewWord"]
                </a>
            </div>
        }
        else
        {
            <p>@Localizer["WelcomeGuest"]</p>
            <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
                <a class="btn btn-light text-primary action-btn" asp-controller="Auth" asp-action="Login">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> @Localizer["LoginNow"]
                </a>
                <a class="btn btn-outline-light action-btn" asp-controller="Auth" asp-action="Register">
                    <i class="fa-solid fa-user-plus me-2"></i> @Localizer["RegisterNow"]
                </a>
            </div>
        }
    </div>

    <!-- FEATURE CARDS -->
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm highlight-card h-100">
                <div class="card-body">
                    <i class="fa-solid fa-brain fa-2x text-primary mb-3"></i>
                    <h5 class="card-title">@Localizer["FeatureRepetitionTitle"]</h5>
                    <p class="card-text">@Localizer["FeatureRepetitionDesc"]</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm highlight-card h-100">
                <div class="card-body">
                    <i class="fa-solid fa-puzzle-piece fa-2x text-success mb-3"></i>
                    <h5 class="card-title">@Localizer["FeatureGamesTitle"]</h5>
                    <p class="card-text">@Localizer["FeatureGamesDesc"]</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm highlight-card h-100">
                <div class="card-body">
                    <i class="fa-solid fa-chart-line fa-2x text-warning mb-3"></i>
                    <h5 class="card-title">@Localizer["FeatureStatsTitle"]</h5>
                    <p class="card-text">@Localizer["FeatureStatsDesc"]</p>
                </div>
            </div>
        </div>
    </div>

</div>